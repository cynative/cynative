{
  "api": {
    "compute": {
      "restUrl": "https://www.googleapis.com/discovery/v1/apis/compute/v1/rest",
      "methods": {
        "compute.instances.insert": {
          "permissions": [
            {"name": "compute.instances.create", "discoveryMethodologies": ["restcrawliamblockv1"]},
            {"name": "iam.serviceAccounts.actAs", "condition": {"bodyPathExists": "$.serviceAccounts[].email"}, "discoveryMethodologies": ["manual"]},
            {"name": "compute.subnetworks.use", "discoveryMethodologies": ["restcrawlv1"]}
          ]
        },
        "compute.instances.get": {
          "permissions": [
            {"name": "compute.instances.get", "discoveryMethodologies": ["restcrawliamblockv1"]}
          ]
        },
        "compute.instances.lowconf": {
          "permissions": [
            {"name": "compute.instances.lowconf", "discoveryMethodologies": ["restcrawlv1"]}
          ]
        },
        "compute.instances.empty": {},
        "compute.instances.mixed": {
          "permissions": [
            {"name": "compute.instances.get", "discoveryMethodologies": ["manual"]},
            {"name": "compute.instances.list", "discoveryMethodologies": ["restcrawlv1"]}
          ]
        },
        "compute.instances.fuzzonly": {
          "permissions": [
            {"name": "compute.instances.fuzzed", "discoveryMethodologies": ["fuzzv1"]}
          ]
        }
      }
    },
    "container": {
      "restUrl": "https://container.googleapis.com/$discovery/rest?version=v1",
      "methods": {
        "container.projects.locations.clusters.get": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.locations.clusters.list": {
          "permissions": [{"name": "container.clusters.list", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.locations.clusters.nodePools.get": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.locations.clusters.nodePools.list": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.locations.operations.get": {
          "permissions": [{"name": "container.operations.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.locations.operations.list": {
          "permissions": [{"name": "container.operations.list", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.clusters.get": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.clusters.list": {
          "permissions": [{"name": "container.clusters.list", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.clusters.nodePools.get": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.clusters.nodePools.list": {
          "permissions": [{"name": "container.clusters.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.operations.get": {
          "permissions": [{"name": "container.operations.get", "discoveryMethodologies": ["restcrawlv1"]}]
        },
        "container.projects.zones.operations.list": {
          "permissions": [{"name": "container.operations.list", "discoveryMethodologies": ["restcrawlv1"]}]
        }
      }
    }
  }
}
